# مفتاح Claude API — احصل عليه من https://platform.claude.com
ANTHROPIC_API_KEY=your-api-key-here

# اختياري
CLAUDE_MODEL=claude-opus-5
TRANSCRIPT_LANGUAGES=ar,en
MAX_POSTS=10

# بروكسي لطلبات يوتيوب (مفيد عند حظر عناوين IP للخوادم السحابية)
# YOUTUBE_PROXY_URL=http://user:pass@proxy-host:port

# ---------- الموقع والخطة المجانية ----------
SITE_NAME=YT2X
# الرابط العام للموقع: يُستخدم في العلامة المائية وروابط العودة من Stripe
PUBLIC_BASE_URL=http://127.0.0.1:8000
FREE_SUMMARY_LIMIT=3
DATABASE_PATH=data/app.db

# ---------- Stripe ----------
# من لوحة Stripe: Developers > API keys (استخدم مفاتيح sk_test_ للتجربة)
STRIPE_SECRET_KEY=
# معرّف السعر للاشتراك الشهري: Product catalog > السعر > price_...
STRIPE_PRICE_ID=
# سرّ الـ Webhook: stripe listen --forward-to localhost:8000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# النص المعروض في نافذة الترقية فقط (السعر الفعلي يحدده STRIPE_PRICE_ID وPAYPAL_PLAN_ID)
PRO_PRICE_LABEL=$9 / شهريًا

# ---------- PayPal ----------
# live للدفعات الحقيقية، sandbox للتجربة (يجب أن يطابق نوع التطبيق الذي أخذت منه المفاتيح)
PAYPAL_ENV=live
# معرّف العميل: عام بطبيعته ويظهر في المتصفح داخل أزرار PayPal
PAYPAL_CLIENT_ID=BAATp6udqGzOBRb4TjoQvXdvAkNW590g0NqM99gPN8tYsjB1UY8kibhpo_xRs9lNw7tDSpkPAOv5Zg7rhY
# سرّ العميل من نفس تطبيق REST في developer.paypal.com > Apps & Credentials — لا تشاركه ولا ترفعه للمستودع
PAYPAL_CLIENT_SECRET=
# معرّف خطة الاشتراك الشهري (P-...) من PayPal > Subscriptions > Plans، بنفس عملة PAYPAL_CURRENCY
PAYPAL_PLAN_ID=
# معرّف الـ Webhook من إعدادات التطبيق، للأحداث BILLING.SUBSCRIPTION.*
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# ---------- تسجيل الدخول بالبريد الإلكتروني ----------
# يُرسل رمز دخول من 6 أرقام عبر SMTP (مثل Gmail أو Brevo أو Resend أو SendGrid أو Mailgun)
SMTP_HOST=
SMTP_PORT=587
# starttls للمنفذ 587، أو ssl للمنفذ 465
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# عنوان المرسل، ويجب أن يكون نطاقه موثّقًا لدى مزوّد البريد
EMAIL_FROM=YT2X <no-reply@your-domain.com>
# للتطوير المحلي فقط: يطبع رمز الدخول في سجل الخادم بدل إرساله (لا تفعّله في الإنتاج)
DEV_EMAIL_LOG=false
# true = لا يمكن استخدام المحاولات المجانية دون تسجيل الدخول (يمنع تصفير الحصة بمسح الكوكيز)
REQUIRE_LOGIN=false
# مدة بقاء الجلسة بالأيام
SESSION_DAYS=30
